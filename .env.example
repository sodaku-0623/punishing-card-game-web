# Database
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/zhanshuang_tcg?schema=public"

# Backend Server
PORT=4000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"
# JWT 签名密钥：请替换为随机长字符串 (例如 `openssl rand -hex 32`)。
# 留空时服务端会为每次启动生成随机密钥（重启后需重新登录）。
JWT_SECRET=""
# 默认管理员账号 admin 的初始密码。生产环境 (NODE_ENV=production) 未配置时会随机生成并打印到控制台。
ADMIN_PASSWORD=""

# Frontend Web (以下 NEXT_PUBLIC_* 均在前端构建时生效)
# 自建部署 (npm start / 便携版 / 内网穿透) 请保持注释：前端会自动连接当前访问地址。
# 只有前后端分离部署 (如 Cloudflare 版) 时才需要设置：
# NEXT_PUBLIC_SERVER_URL="https://api.example.com"
# NEXT_PUBLIC_WS_TRANSPORT="native"   # native = 连接 Cloudflare Worker；不设置 = Socket.IO (Node 服务端)
# NEXT_PUBLIC_CARD_CDN="https://cards.example.com"
# Next.js 将 /api/* 反向代理到的后端地址 (构建时生效；Docker Compose 中应为 http://server:4000)
API_PROXY_TARGET="http://127.0.0.1:4000"
