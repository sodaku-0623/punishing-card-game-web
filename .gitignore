# Cloudflare 版前端构建产物 (Next.js 静态导出，由 scripts/build-cf-static.mjs 复制到 Worker 静态资源目录)
apps/web/out/
apps/worker/static/*
!apps/worker/static/.gitkeep
!apps/worker/static/.assetsignore

# 根目录 wrangler 配置：由 scripts/generate-root-wrangler.mjs 生成，权威配置在 apps/worker/wrangler.toml
/wrangler.toml

