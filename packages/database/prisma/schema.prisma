datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  WAITING
  READY
  PLAYING
  FINISHED
  CLOSED
}

enum CardTypeEnum {
  ROLE
  TACTICS
  EQUIPMENT
  ASSIST
}

enum ElementAttributeEnum {
  FIRE
  LIGHTNING
  DARK
  ICE
  PHYSICAL
  NONE
  VOID
}

enum SignalOrbTypeEnum {
  RED
  BLUE
  YELLOW
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  passwordHash  String
  nickname      String
  avatarUrl     String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  decks         Deck[]
  roomPlayers   RoomPlayer[]
  gamePlayers   GamePlayer[]
}

model Card {
  id            String                @id @default(uuid())
  cardNumber    String                @unique // 2.7 如 BP01-001
  name          String
  cardType      CardTypeEnum
  attribute     ElementAttributeEnum
  cost          Int
  basePP        Int?
  baseDP        Int?
  signalOrb     SignalOrbTypeEnum?
  traits        String[]              // 特征标签
  isInstant     Boolean               @default(false)
  imageUrl      String?
  rulesText     String
  flavorText    String?
  isActive      Boolean               @default(true)
  currentVersion Int                  @default(1)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  versions      CardVersion[]
  deckCards     DeckCard[]
}

model CardVersion {
  id            String        @id @default(uuid())
  cardId        String
  versionNumber Int
  snapshotData  Json          // 存储完整规则与效果AST
  createdAt     DateTime      @default(now())

  card          Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, versionNumber])
}

model Deck {
  id            String       @id @default(uuid())
  userId        String
  name          String
  description   String?
  isValid       Boolean      @default(false)
  validationLog String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         DeckCard[]
  gamePlayers   GamePlayer[]
}

model DeckCard {
  id            String       @id @default(uuid())
  deckId        String
  cardId        String
  count         Int          @default(1)

  deck          Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card          Card         @relation(fields: [cardId], references: [id])

  @@unique([deckId, cardId])
}

model Room {
  id            String       @id @default(uuid())
  roomCode      String       @unique
  title         String
  passwordHash  String?
  creatorId     String
  status        RoomStatus   @default(WAITING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  players       RoomPlayer[]
  games         Game[]
}

model RoomPlayer {
  id            String       @id @default(uuid())
  roomId        String
  userId        String
  seatIndex     Int          // 0 或 1
  isReady       Boolean      @default(false)
  joinedAt      DateTime     @default(now())

  room          Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, seatIndex])
}

model Game {
  id            String       @id @default(uuid())
  roomId        String
  rngSeed       BigInt
  winnerUserId  String?
  isDraw        Boolean      @default(false)
  finishReason  String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?

  room          Room         @relation(fields: [roomId], references: [id])
  players       GamePlayer[]
  actions       GameActionRecord[]
  events        GameEventRecord[]
}

model GamePlayer {
  id            String       @id @default(uuid())
  gameId        String
  userId        String
  deckId        String
  seatOrder     Int          // 0: 先手, 1: 后手

  game          Game         @relation(fields: [gameId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  deck          Deck         @relation(fields: [deckId], references: [id])

  @@unique([gameId, userId])
}

model GameActionRecord {
  id            String       @id @default(uuid())
  gameId        String
  seq           Int
  playerId      String
  actionType    String
  payload       Json
  timestamp     DateTime     @default(now())

  game          Game         @relation(fields: [gameId], references: [id])

  @@unique([gameId, seq])
}

model GameEventRecord {
  id            String       @id @default(uuid())
  gameId        String
  seq           Int
  eventType     String
  payload       Json
  timestamp     DateTime     @default(now())

  game          Game         @relation(fields: [gameId], references: [id])

  @@unique([gameId, seq])
}
